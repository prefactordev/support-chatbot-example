# ----------------------------------------------------------------------------
# Anthropic
# ----------------------------------------------------------------------------
# Required. Used for the foreground chat and support investigations.
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Primary Prefactor deployment
# ----------------------------------------------------------------------------
# Required. Find these values on your Prefactor deployment page.
PREFACTOR_API_URL=
PREFACTOR_API_TOKEN=
PREFACTOR_AGENT_ID=

# Optional deployment metadata.
PREFACTOR_AGENT_IDENTIFIER=1.0.0
PREFACTOR_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Generic support Prefactor deployment (optional)
# ----------------------------------------------------------------------------
# Provide both the agent ID and token to run every support investigation on one
# linked deployment. An incomplete or omitted pair falls back to the primary.
PREFACTOR_AGENT_ID_SUPPORT=
PREFACTOR_API_TOKEN_SUPPORT=
PREFACTOR_AGENT_IDENTIFIER_SUPPORT=1.0.0
