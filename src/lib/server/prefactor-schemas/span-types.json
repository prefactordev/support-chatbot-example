	{
		"name": "chatbot:quality",
		"title": "User feedback",
		"description": "Thumbs up/down quality signal with selected reasons and optional comment",
		"params_schema": {
			"type": "object",
			"properties": {
				"feedback": {
					"type": "object",
					"properties": {
						"scope": {
							"type": "string"
						},
						"session_id": {
							"type": "string"
						},
						"message_id": {
							"type": "string"
						},
						"message_content": {
							"type": ["string", "null"]
						},
						"rating": {
							"type": "string",
							"enum": ["up", "down"]
						},
						"session_name": {
							"type": ["string", "null"]
						},
						"message_count": {
							"type": ["number", "null"]
						},
						"reasons": {
							"type": ["array", "null"],
							"items": {
								"type": "string"
							}
						},
						"reason_labels": {
							"type": ["array", "null"],
							"items": {
								"type": "string"
							}
						},
						"comment": {
							"type": ["string", "null"]
						}
					},
					"required": ["rating"]
				}
			},
			"required": ["feedback"]
		},
		"result_schema": {
			"type": "object",
			"properties": {
				"feedback": {
					"type": "object",
					"properties": {
						"recorded": {
							"type": "boolean"
						},
						"scope": {
							"type": "string"
						},
						"session_id": {
							"type": "string"
						},
						"message_id": {
							"type": "string"
						},
						"rating": {
							"type": "string",
							"enum": ["up", "down"]
						},
						"reasons": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"reason_labels": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"comment": {
							"type": ["string", "null"]
						}
					},
					"required": ["recorded", "rating"]
				}
			},
			"required": ["feedback"]
		},
		"template": "{% if inputs.feedback.rating == \"up\" %}👍 Positive{% else %}👎 Negative{% endif %} feedback for {{ inputs.feedback.message_id | default: \"message\" }}{% if inputs.feedback.session_name %} — {{ inputs.feedback.session_name }}{% endif %}{% if inputs.feedback.reasons %} · {{ inputs.feedback.reasons | join: \", \" }}{% endif %}{% if inputs.feedback.comment %} · \"{{ inputs.feedback.comment | truncate: 60, \"…\" }}\"{% endif %}",
		"data_risk": {
			"action_profile": {
				"create_data": "allowed",
				"read_data": "allowed",
				"update_data": "disallowed",
				"destroy_data": "disallowed",
				"financial_transactions": "disallowed",
				"external_communication": "disallowed"
			},
			"params_data_categories": {
				"classification": "confidential",
				"personal_identifiers": "unknown",
				"contact_information": "unknown",
				"financial_information": "unknown",
				"health_and_medical": "excluded",
				"criminal_justice": "excluded",
				"authentication_and_secrets": "unknown",
				"organisational_confidential": "included",
				"minors_data": "excluded",
